# Supabase (Landlord Gopher project bgjkjtfgrfiszbzatriq)
VITE_SUPABASE_URL=https://bgjkjtfgrfiszbzatriq.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Environment: production | staging | local. Leave unset for production.
# Staging-only tools (one-click role sign-in, staging ribbon) need a non-production
# value here AND a non-production Supabase URL above. See docs/staging/DESIGN_PLAN.md.
# VITE_APP_ENV=staging

# Demo-account password for one-click sign-in. Staging, preview and local only.
# Set it in the hosting provider's environment settings — never commit a real value,
# and never set it for production. `pnpm dev:local` sets this automatically.
# VITE_DEMO_PASSWORD=

# Optional staging ribbon labels (also injected from Vercel/GitHub SHA when unset).
# VITE_BUILD_ID=
# VITE_GIT_BRANCH=
